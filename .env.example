

# --- Gemini (Google AI Studio) ---
# Obtenla en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ollama (LLM local, sin API key) ---
# Host donde corre el servidor de Ollama. Si lo corres directamente en
# tu máquina (fuera de Docker), deja el valor por defecto.
OLLAMA_HOST=
# Modelo a usar -- descárgalo antes con: ollama pull qwen2.5:1.5b
# Alternativas válidas si ya tienes otro modelo: qwen2.5, gemma3, mistral...
OLLAMA_MODEL=



# --- Gmail API (OAuth2) ---
# Ruta al archivo de credenciales descargado desde Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json
# Ruta donde se guardará el token generado tras el primer login OAuth
GMAIL_TOKEN_PATH=token.json

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/organizador.db

# --- App / entorno ---
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=America/Caracas